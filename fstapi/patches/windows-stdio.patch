 /*
+ * Duplicate gzip descriptors without creating an inheritable Windows handle.
+ * Clearing inheritance after dup() would race with concurrent process creation.
+ */
+#ifdef _WIN32
+static int fstDup(int fd)
+{
+    HANDLE process = GetCurrentProcess();
+    HANDLE copy;
+    int result;
+
+    if (!DuplicateHandle(process,
+                         (HANDLE)_get_osfhandle(fd),
+                         process,
+                         &copy,
+                         0,
+                         FALSE,
+                         DUPLICATE_SAME_ACCESS)) {
+        errno = EIO;
+        return -1;
+    }
+    result = _open_osfhandle((intptr_t)copy, _O_BINARY | _O_NOINHERIT);
+    if (result == -1) {
+        int saved_errno = errno;
+        CloseHandle(copy);
+        errno = saved_errno;
+    }
+    return result;
+}
+#else
+#define fstDup(fd) dup(fd)
+#endif
